#. 已啟用的備份說明
msgid "backupsOnDescription"
msgstr "為了避免每次錄製時都請求權限，我們建議保持此選項卡打開。"

# Close tab anyway
# 
# 仍然关闭选项卡
#. 仍然關閉選項卡按鈕
msgid "backupsClose"
msgstr "仍然關閉選項卡"

# Stop backing up all recordings
# 
# 停止所有录制的备份
#. 停止備份按鈕
msgid "backupsStop"
msgstr "停止所有錄製的備份"

# Please reconfirm access to your local Screenity backup folder
# 
# 请重新确认对Screenity本地备份文件夹的访问权限
#. 備份確認標題
msgid "backupsConfirmTitle"
msgstr "請重新確認對Screenity本地備份文件夾的訪問權限"

# We’re sorry, but we need your permission once more to keep backing up your recordings. Unfortunately we will need to ask every time this tab is closed, which can happen if you close the browser or restart your computer.
# 
# 很抱歉，我们需要再次获得您的许可，以继续创建您的录制的本地副本。不幸的是，每次关闭此选项卡时，我们都需要询问，这可能会在您关闭浏览器或重新启动计算机时发生。
#. 備份確認說明
msgid "backupsConfirmDescription"
msgstr ""
"很抱歉，我們需要再次獲得您的許可，以繼續創建您的錄製的本地副本。不幸的是，每次關閉此選項卡時，我們都需要詢問，這可能會在您關閉瀏覽器或重新啟動計算機時發"
"生。"

# Allow Screenity to keep backing up recordings
# 
# 允许Screenity继续备份录制
#. 備份確認中的允許按鈕
msgid "backupsConfirmAllow"
msgstr "允許Screenity繼續備份錄製"

# Back up recordings
# 
# 备份录制
#. 備份切換標籤
msgid "backupsToggle"
msgstr "備份錄製"

# Permission not granted to back up the recording
# 
# 未授予备份录制的权限
#. 備份權限失敗標題
msgid "backupPermissionFailTitle"
msgstr "未授予備份錄製的權限"

# You didn't select a folder to backup your recordings. Depending on your browser version or operating system you might be asked to select the folder every time you start recording. You can try again, or disable backups entirely if you'd rather not give permissions repeatedly.
# 
# 您未选择要创建您的录制的本地副本的文件夹。根据浏览器或操作系统的版本，每次开始录制时可能会要求您选择文件夹。您可以再次尝试或完全禁用备份，如果您不想重复授予权限。
#. 備份權限失敗說明
msgid "backupPermissionFailDescription"
msgstr ""
"您未選擇要創建您的錄製的本地副本的文件夾。根據瀏覽器或操作系統的版本，每次開始錄製時可能會要求您選擇文件夾。您可以再次嘗試或完全禁用備份，如果您不想重複"
"授予權限。"

# Record computer audio
# 
# 录制计算机音频
#. macOS音訊警告標題
msgid "recordAudioWarningMacTitle"
msgstr "錄製計算機音訊"

# In macOS, you can only record Tab audio. Select the Chrome Tab option and make sure 'Also share tab audio' is enabled.
# 
# 在macOS上，您只能录制选项卡的音频。请选择'Chrome选项卡'选项，并确保启用'同时共享选项卡音频'选项。
#. macOS音訊警告說明
msgid "recordAudioWarningMacDescription"
msgstr "在macOS上，您只能錄製選項卡的音訊。請選擇'Chrome選項卡'選項，並確保啟用'同時共享選項卡音訊'選項。"

# Record computer audio
# 
# 录制计算机音频
#. 其他系統音訊警告標題
msgid "recordAudioWarningOtherTitle"
msgstr "錄製計算機音訊"

# Make sure to enable the option to 'Share system audio' if you want to record computer audio. If you don't see this option, try updating Chrome, or switch to Tab recording.
# 
# 如果您想录制计算机音频，请确保启用'共享系统音频'选项。如果您看不到此选项，请尝试更新Chrome或切换到选项卡录制选项。
#. 其他系統音訊警告說明
msgid "recordAudioWarningOtherDescription"
msgstr "如果您想錄製計算機音訊，請確保啟用'共享系統音訊'選項。如果您看不到此選項，請嘗試更新Chrome或切換到選項卡錄製選項。"

# Max resolution
# 
# 最高分辨率
#. 設定選單中的最高解析度標籤
msgid "maxResolutionLabel"
msgstr "最高解析度"

# Max FPS
# 
# 最高帧率
#. 設定選單中的最高幀率標籤
msgid "maxFPSLabel"
msgstr "最高幀率"

# Not enough RAM
# 
# 内存不足
#. 設置選單中的內存不足標籤
msgid "notEnoughRAM"
msgstr "內存不足"

# Resize window
# 
# 调整窗口大小
#. 設定選單中的調整視窗大小標籤
msgid "resizeWindowLabel"
msgstr "調整視窗大小"

# The screen is too small for this resolution
# 
# 屏幕尺寸不足以支持此分辨率
#. 設定選單中的螢幕尺寸不足提示
msgid "screenTooSmallTooltip"
msgstr "螢幕尺寸不足以支援此解析度"

# Cannot record at this resolution in your device
# 
# 您的设备无法以此分辨率录制
#. 設定選單中的最大解析度提示
msgid "maxResolutionTooltip"
msgstr "您的設備無法以此解析度錄製"

# Review permissions
# 
# 审查权限
#. 審查權限按鈕
msgid "permissionsModalReview"
msgstr "審查權限"
